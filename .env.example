# mikrot -- settings template. Copy to .env, then set MIKROT_PASSWORD:
#   Copy-Item .env.example .env
#
# All variables use the MIKROT_ prefix and are read via pydantic-settings.
# Only MIKROT_PASSWORD is required: without it any command that talks to the
# router returns code="config_missing".
#
# Every other variable below is OPTIONAL. The value shown next to each one is
# the built-in default (it matches a factory-fresh MikroTik). If you do not
# need to change a value, you can leave it out of your .env entirely -- the
# default applies automatically. Uncomment and edit a line only to override
# its default.

# --- required ---
MIKROT_PASSWORD=change-me

# --- optional (built-in defaults shown; uncomment only to override) ---
#MIKROT_HOST=192.168.88.1
#MIKROT_PORT=80
#MIKROT_SCHEME=http
#MIKROT_USER=admin
#MIKROT_TIMEOUT=5.0
